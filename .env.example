# Copy this file to ".env" (same folder) and fill in YOUR OWN values. Never share your .env.

# --- MySQL ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=classroom_hub

# --- Cloudinary (cloud file storage) -------------------------
# Paste the "API environment variable" from cloudinary.com -> Console -> API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

SECRET_KEY=type-any-long-random-text-here
